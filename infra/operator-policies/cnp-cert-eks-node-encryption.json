{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateProjectNodeTemplates",
      "Effect": "Allow",
      "Action": "ec2:CreateLaunchTemplate",
      "Resource": "arn:aws:ec2:us-east-1:341936017254:launch-template/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Project": "cloud-native-platform",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Module": "eks"
        },
        "StringLike": {
          "aws:RequestTag/Name": [
            "logistics-platform-dev-api-node-group-encrypted",
            "logistics-platform-dev-worker-node-group-encrypted"
          ]
        }
      }
    },
    {
      "Sid": "TagTemplateAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-1:341936017254:launch-template/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateLaunchTemplate",
          "aws:RequestTag/Project": "cloud-native-platform",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Module": "eks",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ReadTemplateMetadata",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "RetireOnlyLegacyNodeGroups",
      "Effect": "Allow",
      "Action": "eks:DeleteNodegroup",
      "Resource": [
        "arn:aws:eks:us-east-1:341936017254:nodegroup/logistics-platform-dev/api-node-group/a2d09988-ddf4-e743-afe4-c7c5e8e06acf",
        "arn:aws:eks:us-east-1:341936017254:nodegroup/logistics-platform-dev/worker-node-group/14d09988-de14-a02f-cd78-5a0253e781f5"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "LaunchOnlyApprovedEncryptedNodeInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:341936017254:instance/*",
      "Condition": {
        "ArnEquals": {
          "ec2:LaunchTemplate": [
            "arn:aws:ec2:us-east-1:341936017254:launch-template/lt-028e38b7afc60ff60",
            "arn:aws:ec2:us-east-1:341936017254:launch-template/lt-0af8882966d01acba"
          ]
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:InstanceType": "t3.large",
          "ec2:MetadataHttpTokens": "required"
        },
        "NumericEquals": {
          "ec2:MetadataHttpPutResponseHopLimit": "1"
        }
      }
    },
    {
      "Sid": "ApprovedNodeLaunchPrerequisites",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/ami-06ee11fb2e882f9d5",
        "arn:aws:ec2:us-east-1:341936017254:security-group/sg-0239bdf89a2c91139",
        "arn:aws:ec2:us-east-1:341936017254:network-interface/*",
        "arn:aws:ec2:us-east-1:341936017254:launch-template/lt-028e38b7afc60ff60",
        "arn:aws:ec2:us-east-1:341936017254:launch-template/lt-0af8882966d01acba",
        "arn:aws:ec2:us-east-1:341936017254:subnet/subnet-09011c9141587c23e",
        "arn:aws:ec2:us-east-1:341936017254:subnet/subnet-0c2a573199c86c360",
        "arn:aws:ec2:us-east-1:341936017254:subnet/subnet-087613ecfebb9a0e7",
        "arn:aws:ec2:us-east-1:341936017254:security-group/sg-0ab265a7206e5740d"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        },
        "ArnEquals": {
          "ec2:LaunchTemplate": [
            "arn:aws:ec2:us-east-1:341936017254:launch-template/lt-028e38b7afc60ff60",
            "arn:aws:ec2:us-east-1:341936017254:launch-template/lt-0af8882966d01acba"
          ]
        }
      }
    },
    {
      "Sid": "EncryptedNodeRootVolumes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:341936017254:volume/*",
      "Condition": {
        "ArnEquals": {
          "ec2:LaunchTemplate": [
            "arn:aws:ec2:us-east-1:341936017254:launch-template/lt-028e38b7afc60ff60",
            "arn:aws:ec2:us-east-1:341936017254:launch-template/lt-0af8882966d01acba"
          ]
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:VolumeType": "gp3"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericEquals": {
          "ec2:VolumeSize": "50"
        }
      }
    },
    {
      "Sid": "TagNewNodesAndRootVolumes",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:341936017254:instance/*",
        "arn:aws:ec2:us-east-1:341936017254:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "RunInstances",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "PassOnlyExistingBoundedNodeRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::341936017254:role/logistics-platform-dev-api-node-group-role",
        "arn:aws:iam::341936017254:role/logistics-platform-dev-worker-node-group-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
