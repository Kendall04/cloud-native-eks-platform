{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals", "node"],
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "src",
    "server",
    "vite.config.ts",
    "scripts/architecture-assets.mjs"
  ]
}
